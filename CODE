#include <iostream>
using namespace std;

const int SIZE = 5;
const int INF = 99999;

// Function to find minimum time city
int findMin(int time[], bool visited[])
{
    int min = INF;
    int index = -1;

    for(int i = 0; i < SIZE; i++)
    {
        if(visited[i] == false && time[i] < min)
        {
            min = time[i];
            index = i;
        }
    }

    return index;
}

int main()
{
    // Names of places
    string city[SIZE] = {"School", "Bus Stand", "Hospital", "Mall", "Railway Station"};

    // Time graph (minutes)
    int graph[SIZE][SIZE] =
    {
        {0, 10, 20, 30, 15},
        {10, 0, 25, 17, 28},
        {20, 25, 0, 12, 18},
        {30, 17, 12, 0, 14},
        {15, 28, 18, 14, 0}
    };

    int time[SIZE];
    bool visited[SIZE];

    // Initialize
    for(int i = 0; i < SIZE; i++)
    {
        time[i] = INF;
        visited[i] = false;
    }

    int start = 0; // School
    time[start] = 0;

    // Dijkstra Algorithm
    for(int count = 0; count < SIZE - 1; count++)
    {
        int current = findMin(time, visited);

        visited[current] = true;

        for(int j = 0; j < SIZE; j++)
        {
            if(!visited[j] &&
               graph[current][j] &&
               time[current] + graph[current][j] < time[j])
            {
                time[j] = time[current] + graph[current][j];
            }
        }
    }

    //Output
    cout << "Shortest Driving Time from " << city[start] << ":\n\n";

    for(int i = 0; i < SIZE; i++)
    {
        cout << city[start] << " -> " << city[i]
             << " = " << time[i] << " minutes" << endl;
    }

    return 0;
}
