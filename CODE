#include <stdio.h>

#define V 4
#define INF 9999

int main()
{
    int graph[V][V] = {
        {0, 10, 5, 0},
        {10, 0, 2, 1},
        {5, 2, 0, 9},
        {0, 1, 9, 0}
    };

    int dist[V] = {INF, INF, INF, INF};
    int visited[V] = {0};

    dist[0] = 0;

    for (int i = 0; i < V - 1; i++)
    {
        int min = INF, u;

        for (int j = 0; j < V; j++)
        {
            if (!visited[j] && dist[j] < min)
            {
                min = dist[j];
                u = j;
            }
        }

        visited[u] = 1;

        for (int v = 0; v < V; v++)
        {
            if (graph[u][v] && !visited[v] && dist[u] + graph[u][v] < dist[v])
            {
                dist[v] = dist[u] + graph[u][v];
            }
        }
    }

    printf("Shortest time from source:\n");

    for (int i = 0; i < V; i++)
    {
        printf("To %d = %d\n", i, dist[i]);
    }

    return 0;
}
